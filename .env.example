# ─────────────────────────────────────────────────────────────
#  Локальная разработка
# ─────────────────────────────────────────────────────────────
# Оставьте DATABASE_URL пустым — тогда используется встроенная база
# PGlite (папка .pgdata), Docker не нужен.
# DATABASE_URL=
# PGLITE_PATH=.pgdata
# Каталог фото (по умолчанию ./uploads):
# UPLOAD_DIR=./uploads
# Адрес сайта для ссылок входа в выводе скриптов:
# APP_URL=http://localhost:3000
# Пароли демо-сида (npm run db:setup):
# DEMO_PASSWORD=demo-pass-2026
# ADMIN_PASSWORD=admin-pass-2026

# ─────────────────────────────────────────────────────────────
#  Прод на сервере (docker compose) — скопируйте в файл .env
# ─────────────────────────────────────────────────────────────
# Домен сервиса (A-запись на IP сервера). Сертификат выпустит Traefik.
DOMAIN=zayavki.example.ru

# Пароль пользователя базы данных (придумайте надёжный).
POSTGRES_PASSWORD=change_me_please
# Необязательно (по умолчанию zayavki / zayavki):
# POSTGRES_USER=zayavki
# POSTGRES_DB=zayavki

# Имя образа приложения (собирается локально, docker load на сервере):
# APP_IMAGE=zayavki-app:latest
# Имя HTTPS entrypoint у Traefik (проверить в /opt/beget/n8n/docker-compose.yml):
# TRAEFIK_ENTRYPOINT=websecure

# DATABASE_URL, APP_URL и UPLOAD_DIR для контейнера docker-compose подставляет сам.
