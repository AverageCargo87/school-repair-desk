# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local PGlite dev database
/.pgdata

# typescript
*.tsbuildinfo
next-env.d.ts

# uploaded photos (local dev)
/uploads

# generated credentials (passwords, login links)
/data/*.local.*

# bundled maintenance scripts (built in Docker)
/tools

# files for handover (passwords)
/handover

# local deploy bundle
/deploy/out
